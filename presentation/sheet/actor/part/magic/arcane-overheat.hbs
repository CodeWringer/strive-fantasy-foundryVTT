{{!--
viewModel: ViewModel
--}}
<div id="{{viewModel.id}}" class="sheet-block flex flex-column flex-grow flex-middle">
  <div class="flex flex-row auto-margin-h-sm">
    {{!-- Arcane Slag --}}
    <div class="flex flex-column flex-middle">
      {{!-- Icon --}}
      <i id="{{viewModel.vmSlagReminder.id}}" class="ico dark ico-arcanioactivity-solid" style="width: 32px; height: 32px; margin-top: 8px; margin-bottom: 8px;"></i>
      <div class="flex flex-row flex-middle">
        {{!-- Current Value --}}
        {{> inputNumberSpinner viewModel=viewModel.vmSlag cssClass="width-md" }}
      </div>
    </div>
    {{!-- Arcane Overheat --}}
    <div class="flex flex-column flex-middle">
      {{!-- Icon --}}
      <i id="{{viewModel.vmOverheatReminder.id}}" class="ico dark ico-gauge-line" style="width: 48px; height: 48px;"></i>
      <div class="flex flex-row flex-middle">
        {{!-- Current Value --}}
        {{> inputNumberSpinner viewModel=viewModel.vmOverheat cssClass="width-md" }}
        {{!-- Adjust button --}}
        {{> button viewModel=viewModel.vmAdjustOverheat heavy=false fill=false skipPadding=true }}
      </div>
      {{!-- Divider --}}
      <span class="margin-t-md margin-b-md" style="height: 1px; width: 100%; background: #000000; background: linear-gradient(90deg,rgba(0, 0, 0, 0) 10%, rgba(0, 0, 0, 1) 35%, rgba(0, 0, 0, 1) 65%, rgba(0, 0, 0, 0) 90%);"></span>
      {{!-- Max Value --}}
      <div class="flex flex-row flex-middle">
        {{> inputNumberSpinner viewModel=viewModel.vmMaxOverheat cssClass="width-md" }}
        <span style="width: 26px;">{{viewModel.maxOverheatModifierString}}</span>
      </div>
    </div>
  </div>
  {{!-- Range --}}
  <div style="width: calc(100% - 32px);">
    <div class="flex flex-row fill" style="position: relative; height: 32px;">
      <div id="{{viewModel.vmThresholdCold.id}}" class="flex flex-column" style="position: absolute; left: -16px;">
        <i class="ico dark ico-arcane-overheat-cold-solid{{#if viewModel.isActiveCold}} active{{/if}}" style="height: 32px;"></i>
      </div>
      <div id="{{viewModel.vmThresholdSmoldering.id}}" class="flex flex-column" style="position: absolute; left: calc({{viewModel.overheatSmolderingPercentage}}% - 16px);">
        <i class="ico dark ico-arcane-overheat-smoldering-solid{{#if viewModel.isActiveSmoldering}} active{{/if}}" style="height: 32px;"></i>
      </div>
      <div id="{{viewModel.vmThresholdBroiling.id}}" class="flex flex-column" style="position: absolute; left: calc({{viewModel.overheatBroilingPercentage}}% - 16px);">
        <i class="ico dark ico-arcane-overheat-broiling-solid{{#if viewModel.isActiveBroiling}} active{{/if}}" style="height: 32px;"></i>
      </div>
      <div id="{{viewModel.vmThresholdConsuming.id}}" class="flex flex-column" style="position: absolute; left: calc(100% - 16px);">
        <i class="ico dark ico-arcane-overheat-consuming-solid{{#if viewModel.isActiveConsuming}} active{{/if}}" style="height: 32px;"></i>
      </div>
    </div>
    <div class="flex flex-row flex-middle">
      {{#if viewModel.hasSlag}}
      <span id="{{viewModel.vmOverheatSliderSlag.id}}" class="border-solid-sm custom-system-read-only" style="width: {{viewModel.slagPercentage}}%; height: 8px; min-height: 8px;"></span>
      {{/if}}
      {{#if viewModel.showRangeSlider}}
      <span class="flex flex-middle" style="width: {{viewModel.sliderPercentage}}%;">
        {{> inputSlider viewModel=viewModel.vmOverheatSlider }}
      </span>
      {{/if}}
    </div>
  </div>
</div>